<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the app keeps no account and no user data worth backing up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
