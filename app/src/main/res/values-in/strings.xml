    <!-- Permission explainer -->
    <string name="permission_title">Satu izin, tiga langkah</string>
    <string name="permission_why">Android hanya mengizinkan penganalisis penyimpanan melihat semua file dengan \"akses semua file\". Izin foto/video saja tidak cukup — hasil pindai akan hampir kosong.</string>
    <string name="permission_step1">Ketuk tombol di bawah untuk membuka pengaturan sistem.</string>
    <string name="permission_step2">Aktifkan \"Izinkan akses untuk mengelola semua file\".</string>
    <string name="permission_step3">Kembali ke sini — pemeriksaan berjalan otomatis.</string>
    <string name="permission_privacy">Semua tetap di perangkat ini: tanpa akun, tanpa unggahan, tanpa analitik.</string>
    <string name="permission_action">Buka akses semua file</string>

