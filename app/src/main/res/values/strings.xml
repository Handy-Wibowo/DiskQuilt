    <!-- Permission explainer -->
    <string name="permission_title">One permission, three steps</string>
    <string name="permission_why">Android only lets a storage analyser see every file with \"all files access\". Photo/video access is not enough — the scan would be nearly empty.</string>
    <string name="permission_step1">Tap the button below to open the system setting.</string>
    <string name="permission_step2">Turn on \"Allow access to manage all files\".</string>
    <string name="permission_step3">Come back here — the check runs automatically.</string>
    <string name="permission_privacy">Everything stays on this device: no account, no upload, no analytics.</string>
    <string name="permission_action">Open all-files access</string>

    <!-- Advanced / root -->
    <string name="advanced_title">Advanced — root deep scan</string>
    <string name="advanced_subtitle">Optional: also reads Android/data and Android/obb</string>
    <string name="advanced_root_found">Root detected. Both folders join the scan.</string>
    <string name="advanced_root_missing">Android hides Android/data and Android/obb from every app, with or without all-files access. Without root the scan cannot see them, so its total stays below the volume\'s used space.</string>
    <string name="advanced_root_prompt_warning">Checking for root may show a prompt from your root manager.</string>
