# Copy to keystore.properties (gitignored) before building a release.
# Generate the key once with:
#   keytool -genkeypair -v -keystore diskquilt-release.jks -alias diskquilt \
#           -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks and this file out of git; losing them means you cannot update the app.
storeFile=diskquilt-release.jks
storePassword=CHANGE_ME
keyAlias=diskquilt
keyPassword=CHANGE_ME
